struct mdiv {
    unsigned int divisor; unsigned int multiplier; unsigned int shift;
    inline __attribute__((host)) __attribute__((device)) mdiv() : divisor(0), multiplier(0), shift(0) {}
    inline __attribute__((host)) __attribute__((device)) mdiv(unsigned int divisor_) : divisor(divisor_) {
        unsigned int shift_u32 = 0;
        while ((1U << shift_u32) < divisor_) shift_u32++;
        unsigned long long tmp_u64 = static_cast<unsigned long long>((1UL << shift_u32) - divisor_) << 32;
        multiplier = static_cast<unsigned int>(tmp_u64 / divisor_ + 1);
        shift = shift_u32;
    }

    inline __attribute__((host)) __attribute__((device)) unsigned int div(unsigned int dividend) const { unsigned int tmp = static_cast<unsigned int>((static_cast<unsigned long long>(dividend) * multiplier) >> 32); return (tmp + dividend) >> shift; }
    inline __attribute__((host)) __attribute__((device)) void divmod(unsigned int dividend, unsigned int& quotient, unsigned int& remainder) const { quotient = div(dividend); remainder = dividend - (quotient * divisor); }
    inline __attribute__((host)) __attribute__((device)) unsigned int get() const { return divisor; }
};


