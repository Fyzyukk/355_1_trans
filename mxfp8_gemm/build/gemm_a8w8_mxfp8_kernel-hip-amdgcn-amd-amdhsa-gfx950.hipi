template<index_t V, index_t N> using make_repeated_seq = typename impl::__make_repeated_seq<V, N>::seq_type;

template<index_t...Xs, index_t...Ys> inline __attribute__((host)) __attribute__((device)) constexpr auto concat_seq(seq<Xs...>, seq<Ys...>) { return seq<Xs..., Ys...>{}; }

namespace impl {
template<typename, typename> struct reduce_seq_impl;
template <typename R, index_t I0, index_t I1, index_t... Is> struct reduce_seq_impl<R, seq<I0, I1, Is...>> { using type = typename reduce_seq_impl<R, seq<R{}(I0, I1), Is...>>::type; };
template <typename R, index_t I> struct reduce_seq_impl<R, seq<I>> { using type = seq<I>; };
template <typename R> struct reduce_seq_impl<R, seq<>> { using type = seq<>; };
}
template<typename R, index_t...Xs> inline __attribute__((host)) __attribute__((device)) constexpr auto reduce_seq(seq<Xs...>) { return typename impl::reduce_seq_impl<R, seq<Xs...>>::type{}; }
template<index_t...Xs> inline __attribute__((host)) __attribute__((device)) constexpr auto reduce_seq_sum(seq<Xs...>) { if constexpr (sizeof...(Xs) == 0) return seq<>{}; else return seq<(Xs + ...)>{}; }
template<index_t...Xs> inline __attribute__((host)) __attribute__((device)) constexpr auto reduce_seq_mul(seq<Xs...>) { if constexpr (sizeof...(Xs) == 0) return seq<>{}; else return seq<(Xs * ...)>{}; }

template<typename T> struct is_seq : false_type {};
template<index_t... Is> struct is_seq<seq<Is...>> : true_type {};
template<typename T> constexpr bool is_seq_v = is_seq<remove_cvref_t<T>>::value;

template<typename T> inline __attribute__((host)) __attribute__((device)) constexpr std::enable_if_t<is_seq_v<T>, index_t> size(T&&) { return remove_cvref_t<T>::size(); }
template<typename T> inline __attribute__((host)) __attribute__((device)) constexpr std::enable_if_t<is_seq_v<T>, index_t> size() { return remove_cvref_t<T>::size(); }

template <index_t I, typename T, std::enable_if_t<is_seq_v<T>, bool> = true> inline __attribute__((host)) __attribute__((device)) constexpr decltype(auto) get(T const& t) { static_assert(I < T::size()); return t[number<I>{}]; }
template <index_t I, typename T, std::enable_if_t<is_seq_v<T>, bool> = true> inline __attribute__((host)) __attribute__((device)) constexpr decltype(auto) get(T& t) { static_assert(I < T::size()); return t[number<I>{}]; }
template <index_t I, typename T, std::enable_if_t<is_seq_v<T>, bool> = true> inline __attribute__((host)) __attribute__((device)) constexpr decltype(auto) get(T&& t) { static_assert(I < T::size()); return t[number<I>{}]; }


namespace impl {
template <class T> struct static_for_impl;
template <index_t... Is> struct static_for_impl<seq<Is...>> { template <class F> inline __attribute__((host)) __attribute__((device)) constexpr void operator()(F&& f) const { (f(number<Is>{}), ...); } };
}
template<index_t N, typename F> inline __attribute__((host)) __attribute__((device)) constexpr void static_for(F f) { impl::static_for_impl<make_index_seq<N>>{}(f); }

template<typename F, typename... R, std::enable_if_t<(is_constant_v<R> && ...), bool> = true>
inline __attribute__((host)) __attribute__((device)) constexpr void static_for(F f, R...) { impl::static_for_impl<make_index_seq<R::value...>>{}(f); }

namespace impl {

template <index_t D, index_t... Is, index_t... Ns> constexpr index_t ford_stride(seq<Is...>, seq<Ns...>) { return ((Is > D ? Ns : index_t(1)) * ... * index_t(1)); }
template <index_t D, index_t... Is, index_t... Ns> constexpr index_t ford_dim(seq<Is...>, seq<Ns...>) { return ((Is == D ? Ns : index_t(1)) * ...); }
template <index_t I, index_t D, index_t... Ns> constexpr index_t ford_at() { return (I / ford_stride<D>(make_index_seq<sizeof...(Ns)>{}, seq<Ns...>{})) % ford_dim<D>(make_index_seq<sizeof...(Ns)>{}, seq<Ns...>{}); }
template <typename Seq> struct static_ford_impl;
template <index_t... Ns> struct static_ford_impl<seq<Ns...>> {
    template <typename F, index_t I, index_t... Ds> inline __attribute__((host)) __attribute__((device)) static constexpr void call_one(F& f, number<I>, seq<Ds...>) { f(number<ford_at<I, Ds, Ns...>()>{}...); }
    template <typename F> inline __attribute__((host)) __attribute__((device)) constexpr void operator()(F f) const { static_for<(Ns * ... * 1)>([&](auto I) { call_one(f, I, make_index_seq<sizeof...(Ns)>{}); }); }
};
template <> struct static_ford_impl<seq<>> { template <typename F> inline __attribute__((host)) __attribute__((device)) constexpr void operator()(F f) const { f(); } };
}

template<index_t... N, typename F> inline __attribute__((host)) __attribute__((device)) constexpr void static_ford(F f) { impl::static_ford_impl<seq<N...>>{}(f); }
template<index_t... N, typename F> inline __attribute__((host)) __attribute__((device)) constexpr void static_ford(seq<N...>, F f) { impl::static_ford_impl<seq<N...>>{}(f); }
template <class... T> struct tuple;
template<index_t... N, typename F> inline __attribute__((host)) __attribute__((device)) constexpr void static_ford(tuple<number<N>...>, F f) { impl::static_ford_impl<seq<N...>>{}(f); }

template<typename T, typename R = void> struct get_value_type { using type = remove_cvref_t<T>; };
template<typename T, typename R = void> using get_value_t = typename get_value_type<T, R>::type;



template <typename T, index_t N>
struct array {
    using value_type = remove_cvref_t<T>;
    using type = array<value_type, N>;







    inline __attribute__((host)) __attribute__((device)) constexpr value_type& operator[](index_t pos) { return content[pos]; }
    inline __attribute__((host)) __attribute__((device)) constexpr const value_type& operator[](index_t pos) const { return content[pos]; }
    template<index_t I> inline __attribute__((host)) __attribute__((device)) constexpr value_type& operator[](number<I>) { return content[I]; }
    template<index_t I> inline __attribute__((host)) __attribute__((device)) constexpr const value_type& operator[](number<I>) const { return content[I]; }
    inline __attribute__((host)) __attribute__((device)) constexpr void fill(const T& value) { static_for<N>([&](auto i){ content[i.value] = value; }); }
    inline __attribute__((host)) __attribute__((device)) constexpr void clear() { fill(static_cast<T>(0)); }
    inline __attribute__((host)) __attribute__((device)) static constexpr bool empty() { return size() == 0; }
    inline __attribute__((host)) __attribute__((device)) static constexpr index_t size() { return N; }



    value_type content[N] {};
};

template <typename T, index_t N>
inline __attribute__((host)) __attribute__((device)) constexpr bool operator==(const array<T,N>& x, const array<T,N>& y) { for (index_t i = 0; i < N; ++i) { if (x[i] != y[i]) { return false; } } return true; }

template <typename T, index_t N> inline __attribute__((host)) __attribute__((device)) constexpr void clear(array<T,N>& a) { a.clear(); }
template <typename T, index_t N> inline __attribute__((host)) __attribute__((device)) constexpr void fill(array<T,N>& a, T const& value) { a.fill(value); }

template<typename T> struct is_array : false_type {};
template<typename T, index_t N> struct is_array<array<T, N>> : true_type {};
template<typename T> constexpr bool is_array_v = is_array<remove_cvref_t<T>>::value;
template<typename T> struct get_value_type<T, std::enable_if_t<is_array_v<T>>> { using type = typename T::value_type; };

namespace impl {
template<typename> struct is_ref_wrapper : std::false_type{};
template<typename T> struct is_ref_wrapper<std::reference_wrapper<T>> : std::true_type{};
template<typename T> using not_ref_wrapper = std::negation<is_ref_wrapper<std::decay_t<T>>>;

template<typename D, typename...> struct array_return_type_helper { using type = D; };
template<typename... Types>
struct array_return_type_helper<void, Types...> : std::common_type<Types...> {
    static_assert(std::conjunction_v<not_ref_wrapper<Types>...>, "Types cannot contain reference_wrappers when D is void");
};
template<typename D, typename... Types> using array_return_type = opus::array<typename array_return_type_helper<D, Types...>::type, sizeof...(Types)>;
}
template<typename D = void, typename... Types> inline __attribute__((host)) __attribute__((device)) constexpr impl::array_return_type<D, Types...> make_array(Types&&... t) { return {std::forward<Types>(t)...}; }

template <index_t I, typename T, std::enable_if_t<is_array_v<T>, bool> = true> inline __attribute__((host)) __attribute__((device)) constexpr decltype(auto) get(T const& t) { static_assert(I < T::size()); return t[number<I>{}]; }
template <index_t I, typename T, std::enable_if_t<is_array_v<T>, bool> = true> inline __attribute__((host)) __attribute__((device)) constexpr decltype(auto) get(T& t) { static_assert(I < T::size()); return t[number<I>{}]; }
template <index_t I, typename T, std::enable_if_t<is_array_v<T>, bool> = true> inline __attribute__((host)) __attribute__((device)) constexpr decltype(auto) get(T&& t) { static_assert(I < T::size()); return t[number<I>{}]; }

namespace impl {
template <class T0, class T1, index_t... I0, index_t... I1>
inline __attribute__((host)) __attribute__((device)) constexpr auto concat_array(T0 const& t0, T1 const& t1, seq<I0...>, seq<I1...>) { return opus::make_array(get<I0>(t0)..., get<I1>(t1)...); }
template <class T0, class T1, class T2, index_t... I0, index_t... I1, index_t...I2>
inline __attribute__((host)) __attribute__((device)) constexpr auto concat_array(T0 const& t0, T1 const& t1, T2 const& t2, seq<I0...>, seq<I1...>, seq<I2...>) { return opus::make_array(get<I0>(t0)..., get<I1>(t1)..., get<I2>(t2)...); }
template <class T0, class T1, class T2, class T3, index_t... I0, index_t... I1, index_t...I2, index_t...I3>
inline __attribute__((host)) __attribute__((device)) constexpr auto concat_array(T0 const& t0, T1 const& t1, T2 const& t2, T3 const& t3, seq<I0...>, seq<I1...>, seq<I2...>, seq<I3...>) { return opus::make_array(get<I0>(t0)..., get<I1>(t1)..., get<I2>(t2)..., get<I3>(t3)...); }
}
template <class T0> inline __attribute__((host)) __attribute__((device)) constexpr auto concat_array(T0 const& t0) { return t0; }
template <class T0, class T1>
inline __attribute__((host)) __attribute__((device)) constexpr auto concat_array(T0 const& t0, T1 const& t1) { return impl::concat_array(t0, t1, make_index_seq<T0::size()>{}, make_index_seq<T1::size()>{}); }
template <class T0, class T1, class T2>
inline __attribute__((host)) __attribute__((device)) constexpr auto concat_array(T0 const& t0, T1 const& t1, T2 const& t2) { return impl::concat_array(t0, t1, t2, make_index_seq<T0::size()>{}, make_index_seq<T1::size()>{}, make_index_seq<T2::size()>{}); }
template <class T0, class T1, class T2, class T3>
inline __attribute__((host)) __attribute__((device)) constexpr auto concat_array(T0 const& t0, T1 const& t1, T2 const& t2, T3 const& t3) {
                                            return impl::concat_array(t0, t1, t2, t3, make_index_seq<T0::size()>{}, make_index_seq<T1::size()>{}, make_index_seq<T2::size()>{}, make_index_seq<T3::size()>{}); }
template <class T0, class T1, class T2, class T3, class T4, class... Ts>
inline __attribute__((host)) __attribute__((device)) constexpr auto concat_array(T0 const& t0, T1 const& t1, T2 const& t2, T3 const& t3, T4 const& t4, Ts const&... ts) { return concat_array(concat_array(t0, t1, t2, t3), concat_array(t4, ts...)); }

template<typename T> inline __attribute__((host)) __attribute__((device)) constexpr std::enable_if_t<is_array_v<T>, index_t> size(T&&) { return remove_cvref_t<T>::size(); }
template<typename T> inline __attribute__((host)) __attribute__((device)) constexpr std::enable_if_t<is_array_v<T>, index_t> size() { return remove_cvref_t<T>::size(); }


namespace impl {
template <index_t idx, typename T, bool is_empty = (std::is_empty_v<T> || std::is_void_v<T>)> struct tuple_object {};

template <index_t idx, typename T>
struct tuple_object<idx, T, true> {
    inline __attribute__((host)) __attribute__((device)) constexpr tuple_object() {}
    template <typename U, typename std::enable_if<!std::is_same<remove_cvref_t<U>, tuple_object>::value, bool>::type = false>
    inline __attribute__((host)) __attribute__((device)) constexpr tuple_object(U&&) {}
};
template <index_t idx, typename T>
struct tuple_object<idx, T, false> {
    inline __attribute__((host)) __attribute__((device)) constexpr tuple_object() : element{} {}
    template <typename U, typename std::enable_if<!std::is_same<remove_cvref_t<U>, tuple_object>::value, bool>::type = false>
    inline __attribute__((host)) __attribute__((device)) constexpr tuple_object(U&& e) : element(std::forward<U>(e)) {}
    T element;
};


template <index_t I, class T> inline __attribute__((host)) __attribute__((device)) constexpr T getv(const tuple_object<I, T, true>&) { return {}; }
template <index_t I, class T> inline __attribute__((host)) __attribute__((device)) constexpr const T& getv(const tuple_object<I, T, false>& x) { return x.element; }
template <index_t I, class T> inline __attribute__((host)) __attribute__((device)) constexpr T& getv(tuple_object<I, T, false>& x) { return x.element; }
template <index_t I, class T> inline __attribute__((host)) __attribute__((device)) constexpr T&& getv(tuple_object<I, T, false>&& x) { return static_cast<T&&>(x.element); }

template <typename index_seq, typename... T> struct tuple_base;

template <index_t... I, typename... T>
struct tuple_base<seq<I...>, T...> : tuple_object<I, T>... {
    inline __attribute__((host)) __attribute__((device)) constexpr tuple_base() = default;

    template <class U, typename std::enable_if<sizeof...(I) == 1 && sizeof...(T) == 1 && !std::is_same<remove_cvref_t<U>, tuple_base>::value, bool>::type = false>
    inline __attribute__((host)) __attribute__((device)) constexpr tuple_base(U&& u) : tuple_object<I, T>(std::forward<U>(u))... {}

    template <typename... U, typename std::enable_if<sizeof...(U) >= 2, bool>::type = false>
    inline __attribute__((host)) __attribute__((device)) constexpr tuple_base(U&&... u) : tuple_object<I, T>(std::forward<U>(u))... { static_assert(sizeof...(I) == sizeof...(T) && sizeof...(I) == sizeof...(U), "wrong!"); }
};
}
template <class... T>
struct tuple : impl::tuple_base<make_index_seq<sizeof...(T)>, T...> {
    inline __attribute__((host)) __attribute__((device)) static constexpr index_t size() { return sizeof...(T); }
    using base = impl::tuple_base<make_index_seq<sizeof...(T)>, T...>;
    inline __attribute__((host)) __attribute__((device)) constexpr tuple() = default;

    template <typename U, typename std::enable_if<sizeof...(T) == 1 && !std::is_same<remove_cvref_t<U>, tuple>::value, bool>::type = false>
    inline __attribute__((host)) __attribute__((device)) constexpr tuple(U&& u) : base(std::forward<U>(u)) {}

    template <typename... U, typename std::enable_if<sizeof...(U) == sizeof...(T) && sizeof...(U) >= 2, bool>::type = false>
    inline __attribute__((host)) __attribute__((device)) constexpr tuple(U&&... u) : base(std::forward<U>(u)...) {}
};
template<typename... T> __attribute__((host)) __attribute__((device)) tuple(T&&...) -> tuple<remove_cvref_t<T>...>;

namespace impl {
template<typename T, typename S> struct tuple_array_helper;
template<typename T, index_t... Is> struct tuple_array_helper<T, seq<Is...>> { using type = tuple<decltype((Is, remove_cvref_t<T>{}))...>; };
}
template<typename T, index_t N> using tuple_array = typename impl::tuple_array_helper<T, make_index_seq<N>>::type;


template<index_t I, class T> struct tuple_element;
template<index_t I, class... Ts> struct tuple_element<I, opus::tuple<Ts...>> { using type = __type_pack_element<I, Ts...>; };
template<index_t I, class T> using tuple_element_t = typename tuple_element<I, T>::type;

template <index_t I, class... T> inline __attribute__((host)) __attribute__((device)) constexpr decltype(auto) get(tuple<T...> const& t) { static_assert(I < sizeof...(T)); return impl::getv<I>(t); }
template <index_t I, class... T> inline __attribute__((host)) __attribute__((device)) constexpr decltype(auto) get(tuple<T...>& t) { static_assert(I < sizeof...(T)); return impl::getv<I>(t); }
template <index_t I, class... T> inline __attribute__((host)) __attribute__((device)) constexpr decltype(auto) get(tuple<T...>&& t) { static_assert(I < sizeof...(T)); return impl::getv<I>(std::move(t)); }

template <index_t I0, index_t I1, index_t... Is, class T>
inline __attribute__((host)) __attribute__((device)) constexpr decltype(auto) get(T&& t) { return get<I1, Is...>(get<I0>(std::move(t))); }

template <typename... T> inline __attribute__((host)) __attribute__((device)) constexpr auto make_tuple(T&&... xs) { return tuple<remove_cvref_t<T>...>(std::forward<T>(xs)...); }

template<typename F, typename... R, std::enable_if_t<(std::is_integral_v<R> && ...), bool> = true>
inline __attribute__((host)) __attribute__((device)) constexpr void static_for(F f, R... range) {
    if constexpr (sizeof...(range) == 1) { auto end = get<0>(make_tuple(range...)); for(index_t i = 0; i < end; i++) { f(i); } }
    else if constexpr (sizeof...(range) == 2) { auto [start, end] = make_tuple(range...); for(index_t i = start; i < end; i++) { f(i); } }
    else if constexpr (sizeof...(range) == 3) { auto [start, end, step] = make_tuple(range...); for(index_t i = start; i < end; i += step) { f(i); } }
}

namespace impl {
template <typename T, index_t... Is> inline __attribute__((host)) __attribute__((device)) constexpr auto make_repeated_tuple(T&& x, seq<Is...>) { return opus::make_tuple((void(Is), std::forward<T>(x))...); }
}
template <index_t N, typename T> inline __attribute__((host)) __attribute__((device)) constexpr auto make_repeated_tuple(T&& x) { return impl::make_repeated_tuple(std::forward<T>(x), make_index_seq<N>{}); }
template <typename T, index_t N> inline __attribute__((host)) __attribute__((device)) constexpr auto make_repeated_tuple(T&& x, number<N>) { return impl::make_repeated_tuple(std::forward<T>(x), make_index_seq<N>{}); }

