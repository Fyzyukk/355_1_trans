            s_c = MMA{}(s_a, s_b, s_c);
#pragma unroll
            for (index_t j = 0; j < c_len; j++) c_[i_c + j] = s_c[j];
        }
        return c_;
    }

    template<index_t STEP_K, typename VA, typename VB, index_t cbsz = 0, index_t abid = 0, index_t blgp = 0>
    inline __attribute__((device)) constexpr auto step_k(number<STEP_K> step, const VA& a, const VB& b, number<cbsz> = {}, number<abid> = {}, number<blgp> = {}) {
        vtype_c c{0};
        return step_k(step, a, b, c, number<cbsz>{}, number<abid>{}, number<blgp>{});
    }

    template<index_t STEP_K, typename VA, typename VB, typename VC, index_t scale_op_sel_a = 0, index_t scale_op_sel_b = 0,
             std::enable_if_t< (is_array_v< remove_cvref_t<VA> > && is_array_v< remove_cvref_t<VB> > && is_array_v< remove_cvref_t<VC> >), bool > = true>
    inline __attribute__((device)) constexpr auto step_k(number<STEP_K>, const VA& a, const VB& b, const VC& c, int scale_a, int scale_b, number<scale_op_sel_a> = {}, number<scale_op_sel_b> = {}) {
        static_assert(STEP_K < EXPAND_K);
        VC c_ {c};
#pragma unroll
        for (index_t I = 0; I < EXPAND_M * EXPAND_N; I++) {
            index_t i_m = I / EXPAND_N, i_n = I % EXPAND_N;
            auto s_a = a[i_m * EXPAND_K + STEP_K]; auto s_b = b[i_n * EXPAND_K + STEP_K]; auto s_c = c_[i_m * EXPAND_N + i_n];
            s_c = MMA{}(s_a, s_b, s_c, scale_a, scale_b, number<scale_op_sel_a>{}, number<scale_op_sel_b>{}); c_[i_m * EXPAND_N + i_n] = s_c;
        }
        return c_;
    }

    template<index_t STEP_K, typename VA, typename VB, typename VC, index_t scale_op_sel_a = 0, index_t scale_op_sel_b = 0,
             std::enable_if_t< (is_vector_v< remove_cvref_t<VA> > && is_vector_v< remove_cvref_t<VB> > && is_vector_v< remove_cvref_t<VC> >), bool > = true>
    inline __attribute__((device)) constexpr auto step_k(number<STEP_K>, const VA& a, const VB& b, const VC& c, int scale_a, int scale_b, number<scale_op_sel_a> = {}, number<scale_op_sel_b> = {}) {
        static_assert(STEP_K < EXPAND_K);
        static_assert(size<VA>() == tile_a_len);
        static_assert(size<VB>() == tile_b_len);
        static_assert(size<VC>() == tile_c_len);

        constexpr index_t a_len = mma_a_len, b_len = mma_b_len, c_len = mma_c_len;

        VC c_ {c};
#pragma unroll
        for (index_t I = 0; I < EXPAND_M * EXPAND_N; I++) {
            index_t i_m = I / EXPAND_N, i_n = I % EXPAND_N;
            index_t i_a = (i_m * EXPAND_K + STEP_K) * a_len, i_b = (i_n * EXPAND_K + STEP_K) * b_len, i_c = (i_m * EXPAND_N + i_n) * c_len;
            typename MMA::vtype_a s_a;
#pragma unroll
            for (index_t j = 0; j < a_len; j++) s_a[j] = a[i_a + j];
            typename MMA::vtype_b s_b;
#pragma unroll
            for (index_t j = 0; j < b_len; j++) s_b[j] = b[i_b + j];
            typename MMA::vtype_c s_c;
#pragma unroll
            for (index_t j = 0; j < c_len; j++) s_c[j] = c_[i_c + j];
            s_c = MMA{}(s_a, s_b, s_c, scale_a, scale_b, number<scale_op_sel_a>{}, number<scale_op_sel_b>{});
#pragma unroll
            for (index_t j = 0; j < c_len; j++) c_[i_c + j] = s_c[j];
        }
        return c_;
    }

    template<index_t STEP_K, typename VA, typename VB, index_t scale_op_sel_a = 0, index_t scale_op_sel_b = 0>
    inline __attribute__((device)) constexpr auto step_k(number<STEP_K> step, const VA& a, const VB& b, int scale_a, int scale_b, number<scale_op_sel_a> = {}, number<scale_op_sel_b> = {}) {
        vtype_c c{0};
        return step_k(step, a, b, c, scale_a, scale_b, number<scale_op_sel_a>{}, number<scale_op_sel_b>{});
    }

    template<typename S, typename D> inline __attribute__((device)) static constexpr auto y_shape(const S& , const D& ) { return opus::pickup_shape(S{}, D{}, y_dim{}); } template<typename S, typename D> inline __attribute__((device)) static constexpr auto p_shape(const S& , const D& ) { return opus::pickup_shape(S{}, D{}, p_dim{}); } inline __attribute__((device)) static constexpr auto y_shape_a() { return y_shape(shape_a(), dim_a()); } inline __attribute__((device)) static constexpr auto p_shape_a() { return p_shape(shape_a(), dim_a()); } template<index_t cached_vec = 0> inline __attribute__((device)) constexpr auto layout_a() { return make_layout<cached_vec>(shape_a());} template<index_t cached_vec = 0, typename S> inline __attribute__((device)) constexpr auto layout_a(S&& stride) { return make_layout<cached_vec>(shape_a(), unfold_x_stride(dim_a(), shape_a(), stride));} template<index_t cached_vec = 0, typename S, typename C> inline __attribute__((device)) constexpr auto layout_a(S&& stride, C&& z) { static_assert(opus::tuple_count<opus::p_dim>(opus::flatten_tuple(dim_a ())) == size<C>()); return make_layout<cached_vec>(shape_a(), unfold_x_stride(dim_a(), shape_a(), stride), opus::unfold_p_coord(dim_a(), z));} template<index_t cached_vec = 0, typename C> inline __attribute__((device)) constexpr auto layout_a_packed(C&& z) { static_assert(opus::tuple_count<opus::p_dim>(opus::flatten_tuple(dim_a ())) == size<C>()); return make_layout_packed<cached_vec>(shape_a(), opus::unfold_p_coord(dim_a(), z));} template<index_t cached_vec = 0, typename... Ts, std::enable_if_t<(!is_tuple_v<Ts> && ...), bool> = true> inline __attribute__((device)) constexpr auto layout_a(Ts&&... strides) {return layout_a<cached_vec>(opus::make_tuple(strides...)); } template<index_t cached_vec = 0> inline __attribute__((device)) constexpr auto y_layout_a() { return make_layout<cached_vec>(y_shape_a());} inline __attribute__((device)) static constexpr auto y_shape_b() { return y_shape(shape_b(), dim_b()); } inline __attribute__((device)) static constexpr auto p_shape_b() { return p_shape(shape_b(), dim_b()); } template<index_t cached_vec = 0> inline __attribute__((device)) constexpr auto layout_b() { return make_layout<cached_vec>(shape_b());} template<index_t cached_vec = 0, typename S> inline __attribute__((device)) constexpr auto layout_b(S&& stride) { return make_layout<cached_vec>(shape_b(), unfold_x_stride(dim_b(), shape_b(), stride));} template<index_t cached_vec = 0, typename S, typename C> inline __attribute__((device)) constexpr auto layout_b(S&& stride, C&& z) { static_assert(opus::tuple_count<opus::p_dim>(opus::flatten_tuple(dim_b ())) == size<C>()); return make_layout<cached_vec>(shape_b(), unfold_x_stride(dim_b(), shape_b(), stride), opus::unfold_p_coord(dim_b(), z));} template<index_t cached_vec = 0, typename C> inline __attribute__((device)) constexpr auto layout_b_packed(C&& z) { static_assert(opus::tuple_count<opus::p_dim>(opus::flatten_tuple(dim_b ())) == size<C>()); return make_layout_packed<cached_vec>(shape_b(), opus::unfold_p_coord(dim_b(), z));} template<index_t cached_vec = 0, typename... Ts, std::enable_if_t<(!is_tuple_v<Ts> && ...), bool> = true> inline __attribute__((device)) constexpr auto layout_b(Ts&&... strides) {return layout_b<cached_vec>(opus::make_tuple(strides...)); } template<index_t cached_vec = 0> inline __attribute__((device)) constexpr auto y_layout_b() { return make_layout<cached_vec>(y_shape_b());} inline __attribute__((device)) static constexpr auto y_shape_c() { return y_shape(shape_c(), dim_c()); } inline __attribute__((device)) static constexpr auto p_shape_c() { return p_shape(shape_c(), dim_c()); } template<index_t cached_vec = 0> inline __attribute__((device)) constexpr auto layout_c() { return make_layout<cached_vec>(shape_c());} template<index_t cached_vec = 0, typename S> inline __attribute__((device)) constexpr auto layout_c(S&& stride) { return make_layout<cached_vec>(shape_c(), unfold_x_stride(dim_c(), shape_c(), stride));} template<index_t cached_vec = 0, typename S, typename C> inline __attribute__((device)) constexpr auto layout_c(S&& stride, C&& z) { static_assert(opus::tuple_count<opus::p_dim>(opus::flatten_tuple(dim_c ())) == size<C>()); return make_layout<cached_vec>(shape_c(), unfold_x_stride(dim_c(), shape_c(), stride), opus::unfold_p_coord(dim_c(), z));} template<index_t cached_vec = 0, typename C> inline __attribute__((device)) constexpr auto layout_c_packed(C&& z) { static_assert(opus::tuple_count<opus::p_dim>(opus::flatten_tuple(dim_c ())) == size<C>()); return make_layout_packed<cached_vec>(shape_c(), opus::unfold_p_coord(dim_c(), z));} template<index_t cached_vec = 0, typename... Ts, std::enable_if_t<(!is_tuple_v<Ts> && ...), bool> = true> inline __attribute__((device)) constexpr auto layout_c(Ts&&... strides) {return layout_c<cached_vec>(opus::make_tuple(strides...)); } template<index_t cached_vec = 0> inline __attribute__((device)) constexpr auto y_layout_c() { return make_layout<cached_vec>(y_shape_c());}
};
}
struct tiled_mma_adaptor {
    template<typename MMA, index_t... Ts> inline __attribute__((device)) decltype(auto) operator()(MMA&&, number<Ts>...) { return impl::tiled_mma_adaptor<remove_cvref_t<MMA>, Ts...>{};}
};

template<typename MMA, index_t E_M, index_t E_N, index_t E_K, index_t T_M, index_t T_N, index_t T_K, typename A = tiled_mma_adaptor>
inline __attribute__((device)) decltype(auto) make_tiled_mma(MMA&& mma, number<E_M>, number<E_N>, number<E_K>, number<T_M>, number<T_N>, number<T_K>, A&& = {}) {
    return A{}(std::forward<MMA>(mma), number<E_M>{}, number<E_N>{}, number<E_K>{}, number<T_M>{}, number<T_N>{}, number<T_K>{});
}

template<typename MMA, typename ES , typename TS , typename A = tiled_mma_adaptor>
inline __attribute__((device)) decltype(auto) make_tiled_mma(MMA&& mma, ES, TS, A&& = {}) {
    return A{}(std::forward<MMA>(mma), number<get<0>(ES{})>{}, number<get<1>(ES{})>{}, number<get<2>(ES{})>{}, number<get<0>(TS{})>{}, number<get<1>(TS{})>{}, number<get<2>(TS{})>{});
}

template<typename d_a, typename d_b, typename d_c, typename ES , typename TS , typename WS ,



         typename WA = mfma_adaptor,

         typename TA = tiled_mma_adaptor, index_t warp_size = get_warp_size()>
inline __attribute__((device)) decltype(auto) make_tiled_mma(ES, TS, WS, WA&& = {}, TA&& = {}) {



    return TA{}(make_mfma<d_a, d_b, d_c>(WS{}, WA{}, number<warp_size>{}),

            number<get<0>(ES{})>{}, number<get<1>(ES{})>{}, number<get<2>(ES{})>{}, number<get<0>(TS{})>{}, number<get<1>(TS{})>{}, number<get<2>(TS{})>{});
}


template<index_t cached_vec = 0, typename L, typename D, typename S, typename C, std::enable_if_t<is_layout_v<L> && is_tuple_v<D> && is_tuple_v<S> && is_tuple_v<C>, bool> = true>
inline __attribute__((device)) constexpr auto partition_layout(L&& layout, D&& dims, S&& shapes, C&& p_coord) {
    static_assert(opus::tuple_count<opus::p_dim>(opus::flatten_tuple(dims ())) == size<C>());
    return make_layout<cached_vec>(std::forward<S>(shapes), unfold_x_stride(std::forward<D>(dims), std::forward<S>(shapes), layout.stride()), unfold_p_coord(std::forward<D>(dims), p_coord));
}

