template<> struct numeric_limits<fp32_t> {
    static constexpr unsigned int bin_min = 0x00800000, bin_max = 0x7F7FFFFF, bin_lowest = 0xFF7FFFFF, bin_qnan = 0x7FC00000, bin_inf = 0x7F800000;
    inline __attribute__((host)) __attribute__((device)) static constexpr fp32_t min() { return __builtin_bit_cast(fp32_t, bin_min); }
    inline __attribute__((host)) __attribute__((device)) static constexpr fp32_t max() { return __builtin_bit_cast(fp32_t, bin_max); }
    inline __attribute__((host)) __attribute__((device)) static constexpr fp32_t lowest() { return __builtin_bit_cast(fp32_t, bin_lowest); }
    inline __attribute__((host)) __attribute__((device)) static constexpr fp32_t quiet_nan() { return __builtin_bit_cast(fp32_t, bin_qnan); }
    inline __attribute__((host)) __attribute__((device)) static constexpr fp32_t infinity() { return __builtin_bit_cast(fp32_t, bin_inf); }
};
