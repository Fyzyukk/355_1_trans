template<typename S, index_t sel = 0, std::enable_if_t<std::is_same_v<S, fp32x2_t>, bool> = true>
inline __attribute__((device)) constexpr decltype(auto) fp32_to_fp8_packed_x2(const S& s, number<sel> = {}) {
